# Native recovery, outbox, analytics and investigation worker.
# Copy to /etc/transactx/worker.env with mode 0600.
# The shared production config loader requires JWT_SECRET even for this worker.
APP_DEVELOPMENT=false
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
DATABASE_URL=postgres://transactx_worker:REPLACE_DB_PASSWORD@127.0.0.1:5432/transactx?sslmode=disable
BANK_A_CODE=BANK-A
BANK_B_CODE=BANK-B
BANK_A_URL=http://127.0.0.1:8081
BANK_B_URL=http://127.0.0.1:8082
BANK_A_SERVICE_TOKEN=REPLACE_DISTINCT_BANK_A_TOKEN
BANK_B_SERVICE_TOKEN=REPLACE_DISTINCT_BANK_B_TOKEN
TX_DB_MAX_CONNS=8
TX_PAYMENT_CONCURRENCY=2
TX_RECOVERY_ENABLED=true
TX_RECOVERY_CONCURRENCY=2
TX_RECOVERY_STALE_AFTER=30s
TX_RECOVERY_SCAN_INTERVAL=10s
TX_RECOVERY_LEASE=60s
TX_RECOVERY_HEARTBEAT=15s
TX_RECOVERY_ATTEMPT_TIMEOUT=20s
TX_RECOVERY_MAX_ATTEMPTS=20

# Optional Gemini: keep disabled until one-time owner review and release gates.
TX_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_PROVIDER=google
GEMINI_PROJECT_ID=
GEMINI_MODEL=
TX_GEMINI_OWNER_REVIEW=

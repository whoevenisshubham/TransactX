# Copy to /etc/transactx/backup.env with mode 0600. The passfile is separate.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=transactx_backup
PGDATABASE=transactx
PGPASSFILE=/etc/transactx/backup.pgpass
BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT
BACKUP_DIR=/var/lib/transactx/backups
# Set only to a mounted, private, owner-controlled external target.
# BACKUP_OFFVM_DIR=/mnt/private-transactx-backups
BACKUP_MAX_BYTES=2147483648

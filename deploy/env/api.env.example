# Copy to /etc/transactx/api.env with mode 0600. Replace every REPLACE_* value.
APP_ADDR=127.0.0.1:8080
APP_DEVELOPMENT=false
DATABASE_URL=postgres://transactx_api:REPLACE_DB_PASSWORD@127.0.0.1:5432/transactx?sslmode=disable
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=transactx-api
JWT_LIFETIME=15m
DEFAULT_BANK_CODE=BANK-A
BANK_A_CODE=BANK-A
BANK_B_CODE=BANK-B
BANK_A_URL=http://127.0.0.1:8081
BANK_B_URL=http://127.0.0.1:8082
BANK_A_SERVICE_TOKEN=REPLACE_DISTINCT_BANK_A_TOKEN
BANK_B_SERVICE_TOKEN=REPLACE_DISTINCT_BANK_B_TOKEN
TX_SIMULATION_MODE=true
TX_PARTICIPANT_PROVISIONING=false
TX_ALLOW_REGISTRATION=false
TX_CHAOS_ENABLED=false
TX_RECOVERY_CONTROL_ENABLED=false
CORS_ALLOWED_ORIGINS=https://REPLACE_VERCEL_ORIGIN
TX_DB_MAX_CONNS=8
TX_PAYMENT_CONCURRENCY=2

# Separate Google OIDC credentials; leave disabled until owner consent/setup.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://transactx-demo-api.onrender.com/api/auth/oidc/google/callback
OAUTH_FRONTEND_ORIGIN=https://transactx-frontend.vercel.app

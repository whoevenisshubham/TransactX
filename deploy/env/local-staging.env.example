# TransactX Local Staging Environment Configuration Template
# Copy this file to local-staging.env and set your credentials.
# IMPORTANT: Never commit local-staging.env or any file containing live passwords to source control.

# PostgreSQL Connection Configuration
# Replace 'your_db_password_here' with your local PostgreSQL password
DATABASE_URL=postgres://postgres:your_db_password_here@127.0.0.1:5432/transactx_local_staging?sslmode=disable
BANK_A_DATABASE_URL=postgres://postgres:your_db_password_here@127.0.0.1:5432/transactx_local_staging?sslmode=disable
BANK_B_DATABASE_URL=postgres://postgres:your_db_password_here@127.0.0.1:5432/transactx_local_staging?sslmode=disable

# CLI & Script Database Credentials
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_db_password_here
TX_SOURCE_DB=transactx_local_staging
TX_TARGET_DB=transactx_restore_drill

# Core API Server Configuration
APP_ADDR=127.0.0.1:8080
JWT_SECRET=replace_with_secure_random_32_byte_secret_key_minimum_length!
JWT_ISSUER=transactx-api
JWT_LIFETIME=15m
APP_DEVELOPMENT=true
TX_SIMULATION_MODE=true
TX_ALLOW_REGISTRATION=false
TX_PUBLIC_DEMO_AUTH=true
TX_CHAOS_ENABLED=true
TX_RECOVERY_CONTROL_ENABLED=true
TX_DB_MAX_CONNS=8
TX_PAYMENT_CONCURRENCY=2
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Bank Simulators
DEFAULT_BANK_CODE=BANK-A
BANK_A_CODE=BANK-A
BANK_B_CODE=BANK-B
BANK_A_ADDR=127.0.0.1:8081
BANK_B_ADDR=127.0.0.1:8082
BANK_A_URL=http://127.0.0.1:8081
BANK_B_URL=http://127.0.0.1:8082
BANK_A_SERVICE_TOKEN=replace_with_bank_a_token_32b_length_secret
BANK_B_SERVICE_TOKEN=replace_with_bank_b_token_32b_length_secret

# Background Recovery Worker
TX_RECOVERY_ENABLED=true
TX_RECOVERY_CONCURRENCY=2
TX_RECOVERY_SCAN_INTERVAL=5s
TX_RECOVERY_STALE_AFTER=15s
TX_RECOVERY_LEASE_DURATION=15s

# Caddy Local Ingress (Loopback only)
STAGING_INGRESS_URL=http://127.0.0.1:3000

[Unit]
Description=TransactX simulated Bank A
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=transactx
Group=transactx
WorkingDirectory=/opt/transactx/current
EnvironmentFile=/etc/transactx/bank-a.env
ExecStart=/opt/transactx/current/run/transactx-bank-a
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Encrypted whole-database TransactX backup
After=postgresql.service

[Service]
Type=oneshot
User=transactx-backup
Group=transactx-backup
EnvironmentFile=/etc/transactx/backup.env
ExecStart=/opt/transactx/current/deploy/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/transactx/backups

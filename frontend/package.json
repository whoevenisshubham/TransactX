{
  "name": "transactx-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "test": "node --import tsx --test src/config.test.ts src/console.test.ts src/merchant.test.ts src/offlineQueue.test.ts src/offlineReplay.test.ts src/operationalEvents.test.ts src/ops/contracts.test.ts src/ops/worklistFilters.test.ts src/ops/analyticsSeries.test.ts src/qr.test.ts",
    "test:money": "node scripts/verify-money.mjs",
    "test:browser:fixtures": "playwright test",
    "test:browser:live": "playwright test --config playwright.live.config.ts",
    "test:browser:offline-shell": "playwright test --config playwright.offline-shell.config.ts",
    "test:offline-queue": "node --import tsx --test src/offlineQueue.test.ts",
    "test:offline-replay": "node --import tsx --test src/offlineReplay.test.ts",
    "experiment:offline": "node --import tsx scripts/run-offline-experiment.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.5",
    "jsqr": "1.4.0",
    "tsx": "4.23.15"
  }
}

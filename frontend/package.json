{
  "name": "transactx-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "test": "node --import tsx --test src/config.test.ts src/console.test.ts src/merchant.test.ts src/offlineQueue.test.ts src/offlineReplay.test.ts src/operationalEvents.test.ts src/ops/contracts.test.ts src/ops/worklistFilters.test.ts src/ops/analyticsSeries.test.ts src/showcase/catalogue.test.ts src/qr.test.ts src/features/customer/customer.test.ts src/features/customer/remediation.test.ts src/features/customer/durableUnresolved.test.ts src/features/customer/reviewClosure.test.ts",
    "test:money": "node scripts/verify-money.mjs",
    "test:browser:fixtures": "playwright test",
    "test:browser:live": "playwright test --config playwright.live.config.ts",
    "test:browser:offline-shell": "playwright test --config playwright.offline-shell.config.ts",
    "test:offline-queue": "node --import tsx --test src/offlineQueue.test.ts",
    "test:offline-replay": "node --import tsx --test src/offlineReplay.test.ts",
    "experiment:offline": "node --import tsx scripts/run-offline-experiment.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.1",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.6",
    "sonner": "^2.0.8",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.5",
    "jsqr": "1.4.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15"
  }
}

# TransactX Frontend Environment Variables
# API base URL for backend communication.
#
# Primary Topology (Unified Single-Origin via Caddy / Nginx reverse proxy):
# Leave empty so the production bundle resolves to window.location.origin (same origin).
VITE_API_BASE_URL=
#
# Alternative Topology (Decoupled Cloud Services e.g. Vercel + Render):
# Must be an explicit https:// origin in production:
# VITE_API_BASE_URL=https://transactx-api.example.com
#
# Development fallback:
# If unset during 'npm run dev', defaults to http://localhost:8080.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:transactx:contract:tx.v2.1",
  "title": "TransactX v2 shared response contracts",
  "$defs": {
    "CentralPaymentState": {
      "type": "string",
      "enum": [
        "CREATED",
        "VALIDATING",
        "LOCAL_SETTLEMENT",
        "ROUTING",
        "PROCESSING",
        "BANK_SETTLED_CENTRAL_PENDING",
        "COMMITTED",
        "COMPLETED",
        "FAILED",
        "PENDING_RECONCILIATION",
        "REVERSED"
      ]
    },
    "SourceStatus": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "not_applicable",
        "not_collected"
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "$ref": "#/$defs/SourceStatus"
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "status",
        "observedAt",
        "errorCode"
      ],
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 1000
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "PaymentSnapshot": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/CentralPaymentState"
        },
        "amountPaise": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "currency": {
          "type": "string",
          "enum": [
            "INR"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "evidenceId": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "state",
        "amountPaise",
        "currency",
        "createdAt",
        "updatedAt",
        "completedAt",
        "eventVersion",
        "evidenceId"
      ],
      "additionalProperties": false
    },
    "Route": {
      "type": "object",
      "properties": {
        "sourceBankCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "destinationBankCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "executionTargetId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/SourceStatus"
        }
      },
      "required": [
        "sourceBankCode",
        "destinationBankCode",
        "executionTargetId",
        "selectedAt",
        "reasonCode",
        "status"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "operationType": {
          "type": "string",
          "maxLength": 1000
        },
        "bankCode": {
          "type": "string",
          "maxLength": 1000
        },
        "centralStatus": {
          "type": "string",
          "maxLength": 1000
        },
        "participantStatus": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "SUCCEEDED",
                "FAILED",
                "PENDING"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "presence": {
          "type": "string",
          "enum": [
            "present",
            "absent_confirmed",
            "unknown",
            "not_checked"
          ]
        },
        "lastObservedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceStatus": {
          "$ref": "#/$defs/SourceStatus"
        },
        "evidenceId": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "operationId",
        "operationType",
        "bankCode",
        "centralStatus",
        "participantStatus",
        "presence",
        "lastObservedAt",
        "sourceStatus",
        "evidenceId"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "fromState": {
          "type": "string",
          "maxLength": 1000
        },
        "toState": {
          "type": "string",
          "maxLength": 1000
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceId": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "id",
        "sequence",
        "fromState",
        "toState",
        "occurredAt",
        "evidenceId"
      ],
      "additionalProperties": false
    },
    "RecoverySummary": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "scheduled",
            "running",
            "deferred",
            "needs_attention",
            "resolved"
          ]
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "nextAttemptAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastAttemptId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceStatus": {
          "$ref": "#/$defs/SourceStatus"
        }
      },
      "required": [
        "status",
        "attemptCount",
        "nextAttemptAt",
        "lastAttemptId",
        "reasonCode",
        "sourceStatus"
      ],
      "additionalProperties": false
    },
    "EvidenceBundle": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "tx.evidence.v1"
          ]
        },
        "paymentId": {
          "type": "string",
          "format": "uuid"
        },
        "snapshotId": {
          "type": "string",
          "maxLength": 1000
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "payment": {
          "$ref": "#/$defs/PaymentSnapshot"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "maxItems": 20
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "maxItems": 200
        },
        "transitionsTruncated": {
          "type": "boolean"
        },
        "recovery": {
          "$ref": "#/$defs/RecoverySummary"
        },
        "reconciliation": {
          "type": "object",
          "properties": {
            "sourceStatus": {
              "$ref": "#/$defs/SourceStatus"
            },
            "runIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 20
            },
            "discrepancyCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "scopeMismatch": {
              "type": "boolean"
            }
          },
          "required": [
            "sourceStatus",
            "runIds",
            "discrepancyCount",
            "scopeMismatch"
          ],
          "additionalProperties": false
        },
        "integrity": {
          "type": "object",
          "properties": {
            "sourceStatus": {
              "$ref": "#/$defs/SourceStatus"
            },
            "runId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "occurredAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "violationCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "sourceStatus",
            "runId",
            "occurredAt",
            "violationCount"
          ],
          "additionalProperties": false
        },
        "traces": {
          "type": "object",
          "properties": {
            "sourceStatus": {
              "$ref": "#/$defs/SourceStatus"
            },
            "traceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              },
              "maxItems": 20
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "sourceStatus",
            "traceIds",
            "truncated"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 20
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "maxItems": 20
        }
      },
      "required": [
        "schemaVersion",
        "paymentId",
        "snapshotId",
        "collectedAt",
        "payment",
        "route",
        "operations",
        "transitions",
        "transitionsTruncated",
        "recovery",
        "reconciliation",
        "integrity",
        "traces",
        "sources",
        "warnings"
      ],
      "additionalProperties": false
    },
    "WorklistItem": {
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/CentralPaymentState"
        },
        "amountPaise": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "currency": {
          "type": "string",
          "enum": [
            "INR"
          ]
        },
        "sourceBankCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "destinationBankCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ageMs": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryStatus": {
          "type": "string",
          "enum": [
            "none",
            "scheduled",
            "running",
            "deferred",
            "needs_attention",
            "resolved"
          ]
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "nextAttemptAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "projectionVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        }
      },
      "required": [
        "paymentId",
        "state",
        "amountPaise",
        "currency",
        "sourceBankCode",
        "destinationBankCode",
        "createdAt",
        "updatedAt",
        "ageMs",
        "recoveryStatus",
        "attemptCount",
        "nextAttemptAt",
        "reasonCode",
        "projectionVersion"
      ],
      "additionalProperties": false
    },
    "Worklist": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorklistItem"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "projection": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "lagging",
                "rebuilding",
                "unavailable"
              ]
            },
            "updatedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "oldestPendingEventAgeMs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "updatedAt",
            "oldestPendingEventAgeMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "items",
        "nextCursor",
        "asOf",
        "projection"
      ],
      "additionalProperties": false
    },
    "RecoveryAttempt": {
      "type": "object",
      "properties": {
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "paymentId": {
          "type": "string",
          "format": "uuid"
        },
        "workerId": {
          "type": "string",
          "maxLength": 1000
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "stateBefore": {
          "type": "string",
          "maxLength": 1000
        },
        "stateAfter": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "running",
            "progressed",
            "resolved",
            "no_progress",
            "deferred",
            "error",
            "interrupted"
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "operationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 20
        },
        "traceId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "leaseEpoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        }
      },
      "required": [
        "attemptId",
        "paymentId",
        "workerId",
        "startedAt",
        "finishedAt",
        "stateBefore",
        "stateAfter",
        "result",
        "reasonCode",
        "operationIds",
        "traceId",
        "leaseEpoch"
      ],
      "additionalProperties": false
    },
    "Assertion": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "central_state",
            "amount_paise",
            "participant_status",
            "operation_id",
            "bank_code",
            "route_target",
            "recovery_status"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 1000
        },
        "entityId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceId": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "field",
        "value",
        "entityId",
        "evidenceId"
      ],
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 10
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "maxItems": 10
        },
        "contradiction": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "evidenceIds",
        "assertions",
        "contradiction"
      ],
      "additionalProperties": false
    },
    "Inference": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 10
        },
        "contradiction": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "evidenceIds",
        "contradiction"
      ],
      "additionalProperties": false
    },
    "Recommendation": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "runbookChunkIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 5
        }
      },
      "required": [
        "text",
        "runbookChunkIds"
      ],
      "additionalProperties": false
    },
    "InvestigationReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "tx.investigation.v1"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "evidence_only",
            "llm"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 20
        },
        "inferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Inference"
          },
          "maxItems": 10
        },
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "maxItems": 10
        },
        "missingEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 20
        },
        "evidenceCoverage": {
          "type": "string",
          "enum": [
            "complete_for_question",
            "limited",
            "insufficient"
          ]
        },
        "snapshotId": {
          "type": "string",
          "maxLength": 1000
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schemaVersion",
        "mode",
        "summary",
        "facts",
        "inferences",
        "recommendations",
        "missingEvidence",
        "evidenceCoverage",
        "snapshotId",
        "collectedAt"
      ],
      "additionalProperties": false
    },
    "ToolStep": {
      "type": "object",
      "properties": {
        "toolName": {
          "type": "string",
          "maxLength": 1000
        },
        "arguments": {
          "type": "object",
          "maxProperties": 6
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "rejected"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 20
        }
      },
      "required": [
        "toolName",
        "arguments",
        "startedAt",
        "finishedAt",
        "status",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "Investigation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "evidence_only",
            "llm"
          ]
        },
        "report": {
          "anyOf": [
            {
